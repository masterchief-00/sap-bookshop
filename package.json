{
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "cds-plugin-ui5": "^0.13.6",
    "sqlite3": "^6.0.1"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db/bookshop.db"
        }
      }
    }
  },
  "name": "sap-bookshop",
  "version": "1.0.0",
  "dependencies": {
    "@sap/cds": "^9"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-logs_gui": "cds watch --open ns.logsgui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-logs": "cds watch --open ns.logs/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-books": "cds watch --open ns.books/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/logs_gui",
    "app/logs",
    "app/logs",
    "app/books"
  ]
}
