{
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.6",
    "sqlite3": "^6.0.1"
  },
  "cds": {
    "requires": {
      "[production]": {
        "auth": "xsuaa",
        "multitenancy": true
      },
      "html5-repo": true,
      "portal": true,
      "[with-mtx]": {
        "multitenancy": true
      }
    },
    "profile": "with-mtx-sidecar"
  },
  "name": "sap-bookshop",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap-cloud-sdk/connectivity": "^4.7.0",
    "@sap-cloud-sdk/http-client": "^4.7.0",
    "@sap-cloud-sdk/resilience": "^4.7.0",
    "@sap/cds": "^9.9.1",
    "@sap/cds-mtxs": "^3",
    "@sap/xssec": "^4"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-logs_gui": "cds watch --open ns.logsgui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-logs": "cds watch --open ns.logs/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-books": "cds watch --open ns.books/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/logs_gui",
    "app/logs",
    "app/logs",
    "app/books"
  ]
}
